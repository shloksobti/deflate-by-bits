in_returns().astype(float)\nmu=R.mean(0);sd=R.std(0)+1e-12;sh=mu/sd*np.sqrt(252)\n# split-half stability: require positive Sharpe in both halves\nh=len(R)//2\ns1=R[:h].mean(0)/R[:h].std(0);s2=R[h:].mean(0)/R[h:].std(0)\nok=(s1>0)&(s2>0)\nprint(ok.sum())\ndef mk(w):return {n[i]:float(w[i]) for i in np.nonzero(w)[0]}\ncands={}\nw=np.where(ok,sh,0)/sd; cands['stable_all']=w\nfor k in (20,50,100):\n    idx=np.argsort(-np.where(ok,sh,-9))[:k];w=np.zeros(len(n));w[idx]=1/sd[idx];cands[f'top{k}']=w\nw=np.ones(len(n))/sd;cands['eq']=w\nfor k,w in cands.items():print(k,bt.backtest(mk(w)))\nE\n/private/tmp/e6venv/bin/python a.py"}}}
