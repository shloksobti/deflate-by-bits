p/e6venv/bin/python -c \"\nimport bt,numpy as np,collections\ns=bt.signals();R=bt.train_returns().astype(float);print(R.shape)\nsh=R.mean(0)/R.std(0)*np.sqrt(252)\nfam=collections.defaultdict(list)\nfor n,x in zip(s,sh):\n  p=n.split('_');k=p[0]+('_'+'_'.join(p[2:]) if len(p)>2 else '');fam[k].append(x)\nfor k,v in fam.items():print(k,len(v),round(np.mean(v),3),round(np.std(v),3))\ninds=sorted(set(n.split('_')[1] for n in s));print(len(inds),inds)\n# equal weight families\nfor k in fam:\n  idx=[i for i,n in enumerate(s) if (lambda p:p[0]+('_'+'_'.join(p[2:]) if len(p)>2 else ''))(n.split('_'))==k]\n  r=R[:,idx].mean(1);print(k,'EW sharpe',round(r.mean()/r.std()*np.sqrt(252),3))\n\"","description":"Summarize train Sharpe by family"}}}
